# Plantilla de variables de entorno: copiar como .env y completar la clave. El .env no se sube al repo.

# Proveedor del modelo de lenguaje: openai o anthropic
LLM_PROVIDER=openai

# Solo hace falta la clave del proveedor elegido
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales: modelo de cada proveedor (si se dejan vacíos se usan estos valores)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# Embeddings: openai (text-embedding-3-small) o local (all-MiniLM-L6-v2, sin clave).
# Vacío: openai si hay OPENAI_API_KEY, local en caso contrario.
EMBEDDINGS_PROVIDER=
